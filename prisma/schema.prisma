generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String    @id @default(uuid())
  name      String
  phone     String?
  email     String    @unique
  createdAt DateTime  @default(now())
  users     User[]
  products  Product[]
  sales     Sale[]
}

model User {
  id        String   @id @default(uuid())
  companyId String
  name      String
  email     String   @unique
  password  String
  role      Role     @default(EMPLOYEE)
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id])
  sales     Sale[]
}

enum Role {
  OWNER
  EMPLOYEE
}

model Product {
  id        String     @id @default(uuid())
  companyId String
  name      String
  price     Float
  costPrice Float?
  stock     Int        @default(0)
  imageUrl  String?
  barcode   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  company   Company    @relation(fields: [companyId], references: [id])
  saleItems SaleItem[]
}

model Sale {
  id            String        @id @default(uuid())
  companyId     String
  userId        String
  total         Float
  discount      Float         @default(0)
  paymentMethod PaymentMethod
  createdAt     DateTime      @default(now())
  company       Company       @relation(fields: [companyId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  items         SaleItem[]
}

enum PaymentMethod {
  PIX
  CASH
  CARD
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  productId String
  quantity  Int
  unitPrice Float
  subtotal  Float
  sale      Sale    @relation(fields: [saleId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}